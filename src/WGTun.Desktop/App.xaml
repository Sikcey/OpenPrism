<Application x:Class="WGTun.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#1B1F23"/><SolidColorBrush x:Key="Line" Color="#30373C"/><SolidColorBrush x:Key="Accent" Color="#20AF92"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF2F4"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDF2F4"/><Setter Property="Background" Value="#252B2F"/><Setter Property="BorderBrush" Value="#394247"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#20AF92"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#65D3BB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#131619"/><Setter Property="Foreground" Value="#EDF2F4"/><Setter Property="BorderBrush" Value="#394247"/><Setter Property="Padding" Value="9"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#131619"/><Setter Property="Foreground" Value="#EDF2F4"/><Setter Property="BorderBrush" Value="#394247"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,0,8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F4"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EDF2F4"/><Setter Property="Margin" Value="0,8"/></Style>
 </Application.Resources>
</Application>
